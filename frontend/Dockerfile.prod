FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# 카카오 로그인 값은 빌드 시점에 번들로 구워진다. compose build.args로 주입한다.
ARG VITE_KAKAO_CLIENT_ID
ENV VITE_KAKAO_CLIENT_ID=${VITE_KAKAO_CLIENT_ID}
ARG VITE_KAKAO_REDIRECT_URI
ENV VITE_KAKAO_REDIRECT_URI=${VITE_KAKAO_REDIRECT_URI}

# SeeSo 라이선스 키도 빌드 시점에 구워진다. 비어 있으면 MediaPipe 시선 추정으로 폴백한다.
ARG VITE_SEESO_LICENSE_KEY
ENV VITE_SEESO_LICENSE_KEY=${VITE_SEESO_LICENSE_KEY}

RUN npm run build

FROM nginx:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
