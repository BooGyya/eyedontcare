# Host ports
FRONTEND_HOST_PORT=
BACKEND_HOST_PORT=
POSTGRES_PORT=
REDIS_PORT=

# Frontend
VITE_API_BASE_URL=
# Kakao REST API key (client_id) used by the browser to start the OAuth flow.
VITE_KAKAO_CLIENT_ID=
# Must exactly match the backend KAKAO_REDIRECT_URI (default: http://localhost:3102/auth/kakao/callback).
VITE_KAKAO_REDIRECT_URI=

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend authentication
# Base64-encoded value whose decoded length is at least 32 bytes.
JWT_SECRET_KEY=

# Kakao login
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Browser origin used by CORS and WebSocket handshakes
APP_CORS_ALLOWED_ORIGINS=

# WebRTC media server (OpenVidu 3.x / LiveKit)
# OPENVIDU_URL: browser-facing WSS endpoint, e.g. wss://<host>:7443
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET: media access-token signing keys.
# Must match the values on the OpenVidu server. Keep real values out of source control.
OPENVIDU_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Eye-drawing AI scoring (SSAFY GMS, OpenAI-compatible gateway)
# GMS_API_KEY is required for "눈으로 그리기" recognition; without it the API returns
# GAME-003 (recognition not configured). Keep the real key out of source control.
GMS_API_KEY=
GMS_BASE_URI=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
GMS_MODEL=gpt-4o
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요. .env 는 커밋되지 않습니다.


